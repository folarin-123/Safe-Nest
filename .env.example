# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/safenest_db?schema=public"

# JWT
JWT_SECRET="your_jwt_secret_minimum_32_characters_long"
JWT_EXPIRES_IN="7d"

# Redis (for BullMQ)
REDIS_HOST="localhost"
REDIS_PORT="6379"

# Email (SMTP)
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASS="your_smtp_api_key"
EMAIL_FROM="no-reply@yourdomain.com"

# App
PORT="5051"
NODE_ENV="development"

# The base URL of your frontend app — used to build password-reset links.
# e.g. https://myapp.com  (no trailing slash)
APP_BASE_URL="https://myapp.com"

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:5052/auth/google/callback"

# Facebook OAuth
FACEBOOK_APP_ID="your_facebook_app_id"
FACEBOOK_APP_SECRET="your_facebook_app_secret"
FACEBOOK_CALLBACK_URL="http://localhost:5052/auth/facebook/callback"

# Optional: comma-separated list of allowed CORS origins
# FRONTEND_URL="https://myapp.com"

# Mono API
MONO_SECRET_KEY=
MONO_BASE_URL=https://api.withmono.com
MONO_WEBHOOK_SECRET=
