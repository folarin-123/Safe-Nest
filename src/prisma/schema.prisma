generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                @id @default(uuid()) @db.Uuid
  email               String                @unique @db.VarChar(255)
  phone               String?               @unique @db.VarChar(20)      // ← now nullable
  passwordHash        String?               @map("password_hash") @db.VarChar(255) // ← nullable
  fullName            String                @map("full_name") @db.VarChar(200)
  firstName           String?               @map("first_name") @db.VarChar(100)
  lastName            String?               @map("last_name") @db.VarChar(100)
  status              AccountStatus         @default(PENDING_VERIFICATION)
  isVerified          Boolean               @default(false) @map("is_verified")
  mfaEnabled          Boolean               @default(false) @map("mfa_enabled")
  
  oauthProvider       String?               @map("oauth_provider") @db.VarChar(50)
  oauthProviderId     String?               @map("oauth_provider_id") @db.VarChar(255)

  lastLogin           DateTime?             @map("last_login") @db.Timestamptz(6)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  verificationCode    String?               @map("verification_code") @db.VarChar(10)
  verificationExpires DateTime?             @map("verification_expires") @db.Timestamptz(6)

  contributions       Contribution[]
  goals               Goal[]
  manualTxns          ManualTransaction[]
  notificationLogs    NotificationLog[]
  financialProfile    UserFinancialProfile?
  settings            UserSettings?

  analyticsEvents     AnalyticsEvent[]
  passwordResets      PasswordReset[]
  bankAccounts        BankAccount[]


  @@index([email])
  @@index([status])
  @@map("users")
}

model UserSettings {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @unique @map("user_id") @db.Uuid
  theme        ThemePreference @default(LIGHT)
  pushEnabled  Boolean         @default(true) @map("push_enabled")
  emailEnabled Boolean         @default(true) @map("email_enabled")
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model UserFinancialProfile {
  id                  String     @id @default(uuid()) @db.Uuid
  userId              String     @unique @map("user_id") @db.Uuid
  incomeAmount        Decimal?   @map("income_amount") @db.Decimal(12, 2)
  incomeFrequency     Frequency? @map("income_frequency")
  fixedExpenses       Json?      @map("fixed_expenses")
  variableExpenses    Json?      @map("variable_expenses")
  existingSavings     Decimal?   @default(0) @map("existing_savings") @db.Decimal(12, 2)
  existingCommitments Json?      @map("existing_commitments")
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_financial_profiles")
}

model Goal {
  id                    String                  @id @default(uuid()) @db.Uuid
  userId                String                  @map("user_id") @db.Uuid
  category              GoalCategoryType?       @map("category")
  goalName              String                  @map("goal_name") @db.VarChar(255)
  description           String?
  targetAmount          Decimal                 @map("target_amount") @db.Decimal(12, 2)
  currentAmount         Decimal                 @default(0) @map("current_amount") @db.Decimal(12, 2)
  deadline              DateTime                @db.Date
  contributionFrequency Frequency               @map("contribution_frequency")
  preferredContribution Decimal?                @map("preferred_contribution") @db.Decimal(12, 2)
  requiredContribution  Decimal?                @map("required_contribution") @db.Decimal(12, 2)
  status                GoalStatus              @default(ACTIVE)
  goalHealthScore       Float?                  @map("goal_health_score")
  priority              Int?                    @default(0) @map("priority")
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  contributions         Contribution[]
  adjustments           GoalAdjustmentHistory[]
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationLogs      NotificationLog[]

  @@index([userId, status])
  @@index([deadline])
  @@map("goals")
}

model Contribution {
  id                String   @id @default(uuid()) @db.Uuid
  goalId            String   @map("goal_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  amount            Decimal  @db.Decimal(12, 2)
  sourceType        String   @map("type") @db.VarChar(20)
  trackingType      String?  @map("tracking_type") @db.VarChar(50)
  contributionDate  DateTime @default(now()) @map("date") @db.Timestamptz(6)
  externalReference String?  @unique @map("external_reference") @db.VarChar(255)
  goal              Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId, contributionDate(sort: Desc)])
  @@index([userId])
  @@map("contributions")
}

model ManualTransaction {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("manual_transactions")
}

model NotificationLog {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  goalId       String?          @map("goal_id") @db.Uuid
  message      String
  type         NotificationType
  isRead       Boolean          @default(false) @map("is_read")
  scheduledFor DateTime?        @map("scheduled_for") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  goal         Goal?            @relation(fields: [goalId], references: [id])
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, type, createdAt(sort: Desc)])
  @@map("notification_logs")
}

model GoalAdjustmentHistory {
  id        String   @id @default(uuid()) @db.Uuid
  goalId    String   @map("goal_id") @db.Uuid
  reason    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("goal_adjustment_history")
}


model AnalyticsEvent {
  id         String   @id @default(uuid()) @db.Uuid
  eventName  String   @map("event_name") @db.VarChar(255)
  userId     String?  @map("user_id") @db.Uuid
  properties Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventName])
  @@map("analytics_events")
}

model PasswordReset {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}



enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum GoalStatus {
  ACTIVE
  PAUSED
  ACHIEVED
  AT_RISK
  OFF_TRACK
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

enum NotificationType {
  REMINDER
  ALERT
  MILESTONE
  SECURITY
}

enum GoalCategoryType {
  RENT
  SCHOOL_FEES
  EMERGENCY
  VACATION
  CAPITAL
  HOME
}

model BankAccount {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @map("user_id") @db.Uuid
  provider          String            @default("MONO") @db.VarChar(20)
  providerAccountId String            @unique @map("provider_account_id") @db.VarChar(255)
  accountName       String?           @map("account_name") @db.VarChar(255)
  accountNumber     String?           @map("account_number") @db.VarChar(20)
  bankName          String?           @map("bank_name") @db.VarChar(255)
  currency          String?           @default("NGN") @db.VarChar(10)
  status            BankAccountStatus @default(ACTIVE)
  lastSyncedAt      DateTime?         @map("last_synced_at") @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      BankTransaction[]

  @@index([userId])
  @@map("bank_accounts")
}

model BankTransaction {
  id                      String       @id @default(uuid()) @db.Uuid
  bankAccountId           String       @map("bank_account_id") @db.Uuid
  userId                  String       @map("user_id") @db.Uuid
  providerTransactionId   String       @unique @map("provider_transaction_id") @db.VarChar(255)
  amount                  Decimal      @db.Decimal(12, 2)
  narration               String?
  transactionType         String       @map("transaction_type") @db.VarChar(10)
  transactionDate         DateTime     @map("transaction_date") @db.Timestamptz(6)
  status                  BankTxStatus @default(PENDING)
  allocatedGoalId         String?      @map("allocated_goal_id") @db.Uuid
  allocatedContributionId String?      @map("allocated_contribution_id") @db.Uuid
  rawPayload              Json?        @map("raw_payload")
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  bankAccount             BankAccount  @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([bankAccountId])
  @@map("bank_transactions")
}

enum BankAccountStatus {
  ACTIVE
  RECONNECT_REQUIRED
  UNLINKED
}

enum BankTxStatus {
  PENDING
  ALLOCATED
  IGNORED
}