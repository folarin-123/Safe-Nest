<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reset Password — SafeNest</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --brand:       #0f766e;
      --brand-dark:  #0a5c55;
      --brand-light: #e6f4f3;
      --danger:      #dc2626;
      --danger-bg:   #fef2f2;
      --success:     #16a34a;
      --success-bg:  #f0fdf4;
      --text:        #111827;
      --muted:       #6b7280;
      --border:      #e5e7eb;
      --bg:          #f3f4f6;
      --white:       #ffffff;
      --radius:      10px;
      --shadow:      0 4px 24px rgba(0,0,0,.08);
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px 16px;
    }

    /* ── Card ──────────────────────────────────────────────────────────────── */
    .card {
      background: var(--white);
      border-radius: 16px;
      box-shadow: var(--shadow);
      width: 100%;
      max-width: 440px;
      overflow: hidden;
    }

    .card-header {
      background: var(--brand);
      padding: 28px 32px 24px;
      text-align: center;
    }
    .card-header .logo-icon {
      width: 48px; height: 48px;
      background: rgba(255,255,255,.18);
      border-radius: 12px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 12px;
    }
    .card-header .logo-icon svg { color: #fff; }
    .card-header h1 {
      color: #fff;
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: -.01em;
    }
    .card-header p {
      color: rgba(255,255,255,.80);
      font-size: .875rem;
      margin-top: 4px;
    }

    .card-body { padding: 28px 32px 32px; }

    /* ── Alerts ─────────────────────────────────────────────────────────────── */
    .alert {
      border-radius: var(--radius);
      padding: 12px 14px;
      font-size: .875rem;
      font-weight: 500;
      display: flex;
      align-items: flex-start;
      gap: 10px;
      margin-bottom: 20px;
      line-height: 1.4;
    }
    .alert-icon { flex-shrink: 0; margin-top: 1px; }
    .alert.alert-error   { background: var(--danger-bg);  color: var(--danger);  border: 1px solid #fca5a5; }
    .alert.alert-success { background: var(--success-bg); color: var(--success); border: 1px solid #86efac; }

    /* ── Form ───────────────────────────────────────────────────────────────── */
    .form-group { margin-bottom: 18px; }

    label {
      display: block;
      font-size: .8125rem;
      font-weight: 600;
      color: var(--text);
      margin-bottom: 6px;
    }

    .input-wrap {
      position: relative;
      display: flex;
      align-items: center;
    }
    .input-wrap input {
      width: 100%;
      padding: 11px 44px 11px 14px;
      border: 1.5px solid var(--border);
      border-radius: var(--radius);
      font-family: inherit;
      font-size: .9375rem;
      color: var(--text);
      background: var(--white);
      outline: none;
      transition: border-color .18s, box-shadow .18s;
    }
    .input-wrap input::placeholder { color: #9ca3af; }
    .input-wrap input:focus {
      border-color: var(--brand);
      box-shadow: 0 0 0 3px rgba(15,118,110,.12);
    }
    .input-wrap input.is-invalid {
      border-color: var(--danger);
      box-shadow: 0 0 0 3px rgba(220,38,38,.10);
    }
    .toggle-btn {
      position: absolute;
      right: 12px;
      background: none;
      border: none;
      cursor: pointer;
      color: var(--muted);
      display: flex;
      align-items: center;
      padding: 0;
      transition: color .15s;
    }
    .toggle-btn:hover { color: var(--brand); }

    .field-hint {
      font-size: .75rem;
      margin-top: 5px;
      min-height: 16px;
    }
    .field-hint.error   { color: var(--danger); }
    .field-hint.info    { color: var(--muted); }

    /* ── Strength bar ────────────────────────────────────────────────────────── */
    .strength-bar {
      margin-top: 8px;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 4px;
    }
    .strength-bar span {
      height: 3px;
      border-radius: 4px;
      background: var(--border);
      transition: background .25s;
    }
    .strength-bar.s1 span:nth-child(1)               { background: var(--danger); }
    .strength-bar.s2 span:nth-child(-n+2)             { background: #f97316; }
    .strength-bar.s3 span:nth-child(-n+3)             { background: #eab308; }
    .strength-bar.s4 span                             { background: var(--success); }
    .strength-label { font-size: .72rem; color: var(--muted); margin-top: 4px; }

    /* ── Submit button ──────────────────────────────────────────────────────── */
    .btn-primary {
      width: 100%;
      padding: 13px;
      background: var(--brand);
      color: #fff;
      border: none;
      border-radius: var(--radius);
      font-family: inherit;
      font-size: .9375rem;
      font-weight: 600;
      cursor: pointer;
      transition: background .18s, transform .12s, box-shadow .18s;
      margin-top: 6px;
      letter-spacing: .01em;
    }
    .btn-primary:hover  { background: var(--brand-dark); box-shadow: 0 4px 12px rgba(15,118,110,.28); }
    .btn-primary:active { transform: scale(.98); }
    .btn-primary:disabled { opacity: .55; cursor: not-allowed; transform: none; }

    /* ── Footer link ────────────────────────────────────────────────────────── */
    .back-link {
      text-align: center;
      margin-top: 20px;
      font-size: .875rem;
      color: var(--muted);
    }
    .back-link a {
      color: var(--brand);
      font-weight: 500;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      transition: color .15s;
    }
    .back-link a:hover { color: var(--brand-dark); text-decoration: underline; }

    /* ── Success state ──────────────────────────────────────────────────────── */
    .success-state {
      display: none;
      text-align: center;
      padding: 8px 0;
    }
    .success-state .check-circle {
      width: 64px; height: 64px;
      background: var(--success-bg);
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 16px;
    }
    .success-state h2 { font-size: 1.1rem; font-weight: 700; margin-bottom: 8px; }
    .success-state p  { font-size: .875rem; color: var(--muted); line-height: 1.5; }
    .success-state .btn-primary { margin-top: 20px; }

    @media (max-width: 480px) {
      .card-body { padding: 22px 20px 28px; }
      .card-header { padding: 24px 20px 20px; }
    }
  </style>
</head>

<body>
  <div class="card">

    <!-- Header -->
    <div class="card-header">
      <div class="logo-icon">
        <!-- Shield + lock icon -->
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round"
             stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <rect x="9" y="11" width="6" height="5" rx="1"/>
          <path d="M12 11V9a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v2"/>
        </svg>
      </div>
      <h1>Reset your password</h1>
      <p>Choose a strong new password for your SafeNest account</p>
    </div>

    <!-- Body -->
    <div class="card-body">

      <%# ── Flash alerts (server-rendered) ─────────────────────────────── %>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error" role="alert">
          <span class="alert-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="8" x2="12" y2="12"/>
              <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
          </span>
          <span><%= error %></span>
        </div>
      <% } %>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success" role="alert">
          <span class="alert-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
          </span>
          <span><%= success %></span>
        </div>
      <% } %>

      <!-- Success state (shown via JS after successful submit) -->
      <div class="success-state" id="successState">
        <div class="check-circle">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none"
               stroke="#16a34a" stroke-width="2.5" stroke-linecap="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
          </svg>
        </div>
        <h2>Password reset!</h2>
        <p>Your password has been updated successfully.<br/>You can now log in with your new password.</p>
        <a href="/login" class="btn-primary" style="display:inline-block;text-align:center;text-decoration:none;border-radius:10px;margin-top:20px;">
          Go to Login
        </a>
      </div>

      <!-- Reset form -->
      <form id="resetForm" method="POST"
            action="/api/v1/auth/reset-password/<%= token %>"
            novalidate>

        <!-- New Password -->
        <div class="form-group">
          <label for="newPassword">New Password</label>
          <div class="input-wrap">
            <input
              type="password"
              id="newPassword"
              name="newPassword"
              placeholder="Min. 8 characters"
              autocomplete="new-password"
              required
              aria-describedby="newPasswordHint"
            />
            <button type="button" class="toggle-btn" aria-label="Show password"
                    onclick="toggleVisibility('newPassword', this)">
              <svg id="newPassword-eye" width="18" height="18" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
            </button>
          </div>
          <!-- Strength indicator -->
          <div class="strength-bar" id="strengthBar">
            <span></span><span></span><span></span><span></span>
          </div>
          <p class="field-hint info strength-label" id="strengthLabel">Start typing to check strength</p>
          <p class="field-hint error" id="newPasswordHint" role="alert" aria-live="polite"></p>
        </div>

        <!-- Confirm Password -->
        <div class="form-group">
          <label for="confirmPassword">Confirm Password</label>
          <div class="input-wrap">
            <input
              type="password"
              id="confirmPassword"
              name="confirmPassword"
              placeholder="Re-enter your password"
              autocomplete="new-password"
              required
              aria-describedby="confirmPasswordHint"
            />
            <button type="button" class="toggle-btn" aria-label="Show confirm password"
                    onclick="toggleVisibility('confirmPassword', this)">
              <svg id="confirmPassword-eye" width="18" height="18" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
            </button>
          </div>
          <p class="field-hint error" id="confirmPasswordHint" role="alert" aria-live="polite"></p>
        </div>

        <button type="submit" class="btn-primary" id="submitBtn">
          Reset Password
        </button>
      </form>

      <!-- Back link -->
      <p class="back-link">
        <a href="/login">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <line x1="19" y1="12" x2="5" y2="12"/>
            <polyline points="12 19 5 12 12 5"/>
          </svg>
          Back to Login
        </a>
      </p>

    </div><!-- /card-body -->
  </div><!-- /card -->

  <script>
    // ── Show / Hide password toggle ─────────────────────────────────────────
    const eyeOpen = `
      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
      <circle cx="12" cy="12" r="3"/>`;
    const eyeSlash = `
      <line x1="17.94" y1="17.94" x2="22" y2="22"/>
      <path d="M9.9 4.24A9 9 0 0 1 12 4c7 0 11 8 11 8a18.06 18.06 0 0 1-2.16 3.19m-6.72-1.07A3 3 0 1 1 9.88 9.88"/>
      <line x1="1" y1="1" x2="23" y2="23"/>
      <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s4 8 10 8a9.74 9.74 0 0 0 5.39-1.61"/>`;

    function toggleVisibility(fieldId, btn) {
      const input = document.getElementById(fieldId);
      const svg = document.getElementById(fieldId + '-eye');
      const showing = input.type === 'text';
      input.type = showing ? 'password' : 'text';
      svg.innerHTML = showing ? eyeOpen : eyeSlash;
      btn.setAttribute('aria-label', showing ? 'Show password' : 'Hide password');
    }

    // ── Password strength ───────────────────────────────────────────────────
    const strengthBar   = document.getElementById('strengthBar');
    const strengthLabel = document.getElementById('strengthLabel');
    const strengthTexts = ['', 'Weak', 'Fair', 'Good', 'Strong'];
    const strengthColors = ['', '#dc2626', '#f97316', '#eab308', '#16a34a'];

    function calcStrength(pw) {
      if (!pw) return 0;
      let score = 0;
      if (pw.length >= 8)  score++;
      if (pw.length >= 12) score++;
      if (/[A-Z]/.test(pw) && /[a-z]/.test(pw)) score++;
      if (/\d/.test(pw))   score++;
      if (/[^a-zA-Z0-9]/.test(pw)) score++;
      return Math.min(4, score);
    }

    document.getElementById('newPassword').addEventListener('input', function () {
      const score = calcStrength(this.value);
      strengthBar.className = 'strength-bar' + (score > 0 ? ' s' + score : '');
      strengthLabel.textContent = score > 0 ? strengthTexts[score] : 'Start typing to check strength';
      strengthLabel.style.color = score > 0 ? strengthColors[score] : '#6b7280';
      validateNewPassword(this.value);
      // Re-validate confirm if it has a value
      const confirm = document.getElementById('confirmPassword');
      if (confirm.value) validateConfirm(this.value, confirm.value);
    });

    // ── Client-side validation ──────────────────────────────────────────────
    function setFieldState(inputId, hintId, message) {
      const input = document.getElementById(inputId);
      const hint  = document.getElementById(hintId);
      if (message) {
        input.classList.add('is-invalid');
        hint.textContent = message;
      } else {
        input.classList.remove('is-invalid');
        hint.textContent = '';
      }
      return !message;
    }

    function validateNewPassword(value) {
      if (!value)
        return setFieldState('newPassword', 'newPasswordHint', 'Password is required.');
      if (value.length < 8)
        return setFieldState('newPassword', 'newPasswordHint', 'Must be at least 8 characters.');
      if (!/\d/.test(value))
        return setFieldState('newPassword', 'newPasswordHint', 'Must include at least one number.');
      if (!/[A-Z]/.test(value))
        return setFieldState('newPassword', 'newPasswordHint', 'Must include at least one uppercase letter.');
      if (!/[a-z]/.test(value))
        return setFieldState('newPassword', 'newPasswordHint', 'Must include at least one lowercase letter.');
      return setFieldState('newPassword', 'newPasswordHint', '');
    }

    function validateConfirm(newPw, confirmPw) {
      if (!confirmPw)
        return setFieldState('confirmPassword', 'confirmPasswordHint', 'Please confirm your password.');
      if (newPw !== confirmPw)
        return setFieldState('confirmPassword', 'confirmPasswordHint', 'Passwords do not match.');
      return setFieldState('confirmPassword', 'confirmPasswordHint', '');
    }

    document.getElementById('confirmPassword').addEventListener('input', function () {
      validateConfirm(document.getElementById('newPassword').value, this.value);
    });

    // ── Form submit ─────────────────────────────────────────────────────────
    document.getElementById('resetForm').addEventListener('submit', async function (e) {
      e.preventDefault();

      const newPassword     = document.getElementById('newPassword').value;
      const confirmPassword = document.getElementById('confirmPassword').value;

      const pwOk      = validateNewPassword(newPassword);
      const confirmOk = validateConfirm(newPassword, confirmPassword);
      if (!pwOk || !confirmOk) return;

      const btn = document.getElementById('submitBtn');
      btn.disabled = true;
      btn.textContent = 'Resetting…';

      try {
        const res = await fetch(this.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ newPassword, confirmPassword }),
        });

        const data = await res.json().catch(() => ({}));

        if (res.ok) {
          // Hide form, show success state
          document.getElementById('resetForm').style.display = 'none';
          document.querySelector('.back-link').style.display = 'none';

          // Remove any previous server-side alerts
          document.querySelectorAll('.alert').forEach(el => el.remove());

          document.getElementById('successState').style.display = 'block';
        } else {
          // Show server error in a flash alert above the form
          removeClientAlert();
          const alertEl = document.createElement('div');
          alertEl.className = 'alert alert-error';
          alertEl.id = 'clientAlert';
          alertEl.setAttribute('role', 'alert');
          alertEl.innerHTML = `
            <span class="alert-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
              </svg>
            </span>
            <span>${escapeHtml(
              data?.message ||
              (data?.error?.message) ||
              'Something went wrong. Please try again.'
            )}</span>`;
          document.getElementById('resetForm').prepend(alertEl);
          btn.disabled = false;
          btn.textContent = 'Reset Password';
        }
      } catch (_) {
        removeClientAlert();
        const alertEl = document.createElement('div');
        alertEl.className = 'alert alert-error';
        alertEl.id = 'clientAlert';
        alertEl.innerHTML = `
          <span class="alert-icon">⚠</span>
          <span>Network error. Please check your connection and try again.</span>`;
        document.getElementById('resetForm').prepend(alertEl);
        btn.disabled = false;
        btn.textContent = 'Reset Password';
      }
    });

    function removeClientAlert() {
      const prev = document.getElementById('clientAlert');
      if (prev) prev.remove();
    }

    function escapeHtml(str) {
      return String(str)
        .replace(/&/g,'&amp;').replace(/</g,'&lt;')
        .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
  </script>
</body>
