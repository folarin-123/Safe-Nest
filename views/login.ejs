<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Log in - SafeNest</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root { --teal: #0f766e; --deep: #124e4a; --ink: #172221; --muted: #6b7b78; --line: #dce8e5; --wash: #eef8f5; }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 24px; color: var(--ink); font-family: 'DM Sans', sans-serif; background: radial-gradient(circle at 15% 10%, #d8f0e8 0, transparent 35%), linear-gradient(135deg, #f7fbf9, #e6f2ef); }
    main { width: min(100%, 420px); padding: 40px; background: rgba(255,255,255,.94); border: 1px solid rgba(220,232,229,.9); border-radius: 18px; box-shadow: 0 18px 60px rgba(18,78,74,.12); }
    .mark { width: 48px; height: 48px; display: grid; place-items: center; margin-bottom: 24px; color: white; background: var(--teal); border-radius: 14px; font: 700 24px 'Space Grotesk', sans-serif; }
    h1 { margin: 0; font: 700 30px 'Space Grotesk', sans-serif; letter-spacing: 0; } p { color: var(--muted); line-height: 1.5; }
    .error { margin: 20px 0; padding: 12px 14px; color: #a62d2d; background: #fff1f1; border: 1px solid #f5c2c2; border-radius: 9px; }
    .oauth { width: 100%; height: 48px; display: flex; align-items: center; justify-content: center; gap: 10px; margin-top: 14px; border-radius: 9px; font: 600 15px 'DM Sans', sans-serif; cursor: pointer; text-decoration: none; }
    .google { color: #263238; background: white; border: 1px solid #b9c8c5; } .facebook { color: white; background: #1877f2; border: 1px solid #1877f2; }
    .logo { width: 20px; height: 20px; display: grid; place-items: center; font: 700 18px Arial, sans-serif; } .google .logo { color: #4285f4; } .facebook .logo { color: white; }
    .divider { display: flex; align-items: center; gap: 12px; margin: 25px 0 0; color: var(--muted); font-size: 13px; } .divider::before, .divider::after { content: ''; height: 1px; flex: 1; background: var(--line); }
    .email-link { display: block; margin-top: 18px; color: var(--deep); text-align: center; font-weight: 600; text-decoration: none; }
    @media (max-width: 480px) { main { padding: 30px 24px; } }
  </style>
</head>
<body>
  <main>
    <div class="mark" aria-hidden="true">S</div>
    <h1>Welcome back</h1>
    <p>Sign in to keep your financial plans moving forward.</p>
    <% if (error) { %><div class="error" role="alert"><%= error %></div><% } %>
    <a class="oauth google" href="/auth/google"><span class="logo" aria-hidden="true">G</span>Continue with Google</a>
    <a class="oauth facebook" href="/auth/facebook"><span class="logo" aria-hidden="true">f</span>Continue with Facebook</a>
    <div class="divider">or</div>
    <a class="email-link" href="/api/v1/auth/login">Use email and password</a>
  </main>
</body>
</html>